            BackgroundTransparency = 1,
            Text = multi and table.concat(selected, ", ") or tostring(selected),
            Font = Enum.Font.Gotham,
            TextSize = 11,
            TextColor3 = Library.Theme.Muted,
            TextXAlignment = Enum.TextXAlignment.Right,
            TextTruncate = Enum.TextTruncate.AtEnd,
            Parent = header
        })

        local arrow = create("TextLabel", {
            Name = "Arrow",
            Size = UDim2.new(0, 20, 1, 0),
            Position = UDim2.new(1, -22, 0, 0),
            BackgroundTransparency = 1,
            Text = "v",
            Font = Enum.Font.GothamBold,
            TextSize = 10,
            TextColor3 = Library.Theme.Muted,
            Parent = header
        })

        local itemsHolder = create("ScrollingFrame", {
            Name = "ItemsHolder",
            Size = UDim2.new(1, -10, 0, 100),
            Position = UDim2.new(0, 5, 0, 32),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ScrollBarThickness = 2,
            ScrollBarImageColor3 = Library.Theme.Accent,
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            CanvasSize = UDim2.new(0, 0, 0, 0),
            Parent = dropdownFrame
        }, {
            create("UIListLayout", {
                SortOrder = Enum.SortOrder.LayoutOrder,
                Padding = UDim.new(0, 2)
            })
        })

        local function updateText()
            if multi then
                valLabel.Text = (type(selected) == "table" and #selected > 0) and table.concat(selected, ", ") or "None"
            else
                valLabel.Text = tostring(selected)
            end
        end

        local itemBtns = {}
        local function renderItems()
            for _, btn in ipairs(itemBtns) do btn:Destroy() end
            itemBtns = {}

            for _, opt in ipairs(optList) do
                local isSel = multi and (type(selected) == "table" and table.find(selected, opt)) or (selected == opt)
                local itemBtn = create("TextButton", {
                    Name = "Opt_" .. tostring(opt),
                    Size = UDim2.new(1, 0, 0, 22),
                    BackgroundColor3 = isSel and Library.Theme.Accent or Library.Theme.Surface,
                    BackgroundTransparency = isSel and 0.2 or 0.5,
                    BorderSizePixel = 0,
                    Text = "  " .. tostring(opt),
                    Font = Enum.Font.Gotham,
                    TextSize = 11,
                    TextColor3 = isSel and Library.Theme.White or Library.Theme.Muted,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Parent = itemsHolder
                }, {
                    create("UICorner", { CornerRadius = UDim.new(0, 4) })
                })

                itemBtn.MouseButton1Click:Connect(function()
                    if multi then
                        if type(selected) ~= "table" then selected = {} end
                        local idx = table.find(selected, opt)
                        if idx then
                            table.remove(selected, idx)
                        else
                            table.insert(selected, opt)
                        end
                    else
                        selected = opt
                        isOpen = false
                        local ti = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
                        TweenService:Create(dropdownFrame, ti, { Size = UDim2.new(1, 0, 0, 30) }):Play()
                        arrow.Text = "v"
                    end
                    updateText()
                    renderItems()
                    task.spawn(callback, selected)
                end)

                table.insert(itemBtns, itemBtn)
            end
        end

        renderItems()

        header.MouseButton1Click:Connect(function()
            isOpen = not isOpen
            local targetH = isOpen and math.min(140, 36 + #optList * 24) or 30
            arrow.Text = isOpen and "^" or "v"
            local ti = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
            TweenService:Create(dropdownFrame, ti, { Size = UDim2.new(1, 0, 0, targetH) }):Play()
        end)

        return {
            SetValue = function(val)
                selected = val
                updateText()
                renderItems()
                task.spawn(callback, selected)
            end,
            SetOptions = function(newOpts)
                optList = newOpts
                renderItems()
            end,
            GetSelected = function() return selected end
        }
    end

