function Library:CreateWindow(config)
    config = config or {}
    local windowTitle = config.Title or "Myung's Utils"
    local panelW = config.Width or 220
    local panelH = config.Height or 300

    local window = setmetatable({
        Minimized = false,
        Side = "Left",
        YOffset = 200,
        Tabs = {},
        ActiveTab = nil,
        Width = panelW,
        Height = panelH,
    }, { __index = Library })

    -- Main ScreenGui
    local sg = create("ScreenGui", {
        Name = "MyungLibrary_" .. windowTitle,
        ResetOnSpawn = false,
        DisplayOrder = 9999,
        IgnoreGuiInset = true,
        Parent = getGuiParent()
    })
    window.ScreenGui = sg
    table.insert(Library.Instances, sg)

    -- Global Toggle Key Connection
    if not Library.ToggleConnection then
        Library.ToggleConnection = UserInputService.InputBegan:Connect(function(input, gpe)
            if not gpe and input.KeyCode == (Library.ToggleKey or Enum.KeyCode.RightControl) then
                for _, inst in ipairs(Library.Instances) do
                    if inst:IsA("ScreenGui") and inst.Name:find("MyungLibrary_") then
                        inst.Enabled = not inst.Enabled
                    end
                end
            end
        end)
        table.insert(Library.Connections, Library.ToggleConnection)
    end

    -- SideTab (Arrow minimization control)
    local sideTab = create("TextButton", {
        Name = "SideTab",
        Size = UDim2.new(0, 18, 0, 48),
        BackgroundColor3 = Library.Theme.Surface,
        BorderSizePixel = 0,
        Text = "<",
        Font = Enum.Font.GothamBold,
        TextSize = 14,
        TextColor3 = Library.Theme.Accent,
        ZIndex = 10,
        Parent = sg
    }, {
        create("UICorner", { CornerRadius = UDim.new(0, 6) }),
        create("UIStroke", { Color = Library.Theme.Border, Thickness = 1.2 })
    })
    window.SideTab = sideTab

    -- BaseTab (Quick action popout button)
    local baseTabW = 50
    local baseTab = create("Frame", {
        Name = "BaseTab",
        Size = UDim2.new(0, 0, 0, 48),
        BackgroundColor3 = Library.Theme.Yellow,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        ZIndex = 9,
        Parent = sg
    }, {
        create("UICorner", { CornerRadius = UDim.new(0, 6) }),
        create("UIStroke", { Color = Library.Theme.Surface, Thickness = 1.2 })
    })
    window.BaseTab = baseTab

    local baseTabBtn = create("TextButton", {
        Name = "BaseTabBtn",
        Size = UDim2.new(0, baseTabW, 1, 0),
        BackgroundTransparency = 1,
        Text = "Base",
        Font = Enum.Font.GothamBold,
        TextSize = 11,
        TextColor3 = Library.Theme.White,
        ZIndex = 11,
        Parent = baseTab
    }, {
        create("UIStroke", { Color = Color3.new(0,0,0), Thickness = 1 })
    })

    if config.OnBaseClick then
        baseTabBtn.MouseButton1Click:Connect(config.OnBaseClick)
    end

    -- Main Panel
    local panel = create("Frame", {
        Name = "Panel",
        Size = UDim2.new(0, panelW, 0, panelH),
        Position = UDim2.new(0, 22, 0, window.YOffset),
        BackgroundColor3 = Library.Theme.Surface,
        BackgroundTransparency = 0.05,
        BorderSizePixel = 0,
        Active = true,
        Parent = sg
    }, {
        create("UICorner", { CornerRadius = UDim.new(0, 10) }),
        create("UIStroke", { Color = Library.Theme.Border, Thickness = 1.2, Transparency = 0.2 })
    })
    window.Panel = panel

    -- Header
    local header = create("Frame", {
        Name = "Header",
        Size = UDim2.new(1, 0, 0, 30),
        BackgroundColor3 = Library.Theme.Background,
        BackgroundTransparency = 0.1,
        BorderSizePixel = 0,
        Parent = panel
    }, {
        create("UICorner", { CornerRadius = UDim.new(0, 10) }),
        create("Frame", {
            Size = UDim2.new(1, 0, 0, 10),
            Position = UDim2.new(0, 0, 1, -10),
            BackgroundColor3 = Library.Theme.Background,
            BackgroundTransparency = 0.1,
            BorderSizePixel = 0
        }),
        create("TextLabel", {
            Size = UDim2.new(1, -35, 1, 0),
            Position = UDim2.new(0, 10, 0, 0),
            BackgroundTransparency = 1,
            Text = windowTitle,
            Font = Enum.Font.GothamBold,
            TextSize = 12,
            TextColor3 = Library.Theme.White,
            TextXAlignment = Enum.TextXAlignment.Left
        })
    })

    -- Navigation Bar for Tabs
    local tabNav = create("Frame", {
        Name = "TabNav",
        Size = UDim2.new(1, -16, 0, 26),
        Position = UDim2.new(0, 8, 0, 34),
        BackgroundTransparency = 1,
        Parent = panel
    })
    create("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 4),
        Parent = tabNav
    })

    -- Content Area
    local container = create("Frame", {
        Name = "Container",
        Size = UDim2.new(1, -16, 1, -68),
        Position = UDim2.new(0, 8, 0, 64),
        BackgroundTransparency = 1,
        Parent = panel
    })
    window.Container = container
    window.TabNav = tabNav

    -- DOCKING & DYNAMIC WALL-SNAP LAYOUT
    local function getViewport()
        local cam = Workspace.CurrentCamera
        return cam and cam.ViewportSize or Vector2.new(1920, 1080)
    end

    local function applyDockLayout(animate)
        local vp = getViewport()
        local tabX, panelX, baseTabPos, baseTabSize
        if window.Side == "Left" then
            tabX = 0
            panelX = window.Minimized and -(panelW + 4) or 22
            sideTab.Text = window.Minimized and ">" or "<"
            baseTabPos = UDim2.new(0, window.Minimized and (18 + 4) or 0, 0, window.YOffset)
            baseTabSize = UDim2.new(0, window.Minimized and baseTabW or 0, 0, 48)
        else
            tabX = vp.X - 18
            panelX = window.Minimized and (vp.X + 4) or (vp.X - panelW - 22)
            sideTab.Text = window.Minimized and "<" or ">"
            baseTabPos = UDim2.new(0, window.Minimized and (vp.X - 18 - 4 - baseTabW) or (vp.X - 18), 0, window.YOffset)
            baseTabSize = UDim2.new(0, window.Minimized and baseTabW or 0, 0, 48)
        end

        local tabPos = UDim2.new(0, tabX, 0, window.YOffset)
        local panelPos = UDim2.new(0, panelX, 0, window.YOffset)

        if animate then
            local ti = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
            TweenService:Create(sideTab, ti, { Position = tabPos }):Play()
            TweenService:Create(panel, ti, { Position = panelPos }):Play()
            TweenService:Create(baseTab, ti, { Position = baseTabPos, Size = baseTabSize }):Play()
        else
            sideTab.Position = tabPos
            panel.Position = panelPos
            baseTab.Position = baseTabPos
            baseTab.Size = baseTabSize
        end
    end
    window.ApplyDockLayout = applyDockLayout

    task.defer(function() applyDockLayout(false) end)

    -- Header Drag Handler
    local dragToggle, dragStart, startPos = false, nil, nil
    local headerInputConn = header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragToggle = true
            dragStart = input.Position
            startPos = panel.Position
            local conn
            conn = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragToggle = false
                    local vp = getViewport()
                    local midX = panel.Position.X.Offset + panelW / 2
                    window.Side = midX < vp.X / 2 and "Left" or "Right"
                    window.YOffset = math.clamp(panel.Position.Y.Offset, 10, math.max(10, vp.Y - panel.AbsoluteSize.Y - 10))
                    applyDockLayout(true)
                    conn:Disconnect()
                end
            end)
        end
    end)
    table.insert(Library.Connections, headerInputConn)

    local dragMoveConn = UserInputService.InputChanged:Connect(function(input)
        if dragToggle and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            panel.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    table.insert(Library.Connections, dragMoveConn)

    -- SideTab Drag & Click Handler
    local tabDragging, tabTotalDragY, tabDragStartY, tabStartOffset = false, 0, 0, 0
    local sideTabBeganConn = sideTab.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            tabDragging = true
            tabTotalDragY = 0
            tabDragStartY = input.Position.Y
            tabStartOffset = window.YOffset
        end
    end)
    table.insert(Library.Connections, sideTabBeganConn)

    local sideTabEndedConn = UserInputService.InputEnded:Connect(function(input)
        if tabDragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
            tabDragging = false
            local vp = getViewport()
            window.Side = input.Position.X < vp.X / 2 and "Left" or "Right"
            applyDockLayout(true)
        end
    end)
    table.insert(Library.Connections, sideTabEndedConn)

    local sideTabChangedConn = UserInputService.InputChanged:Connect(function(input)
        if tabDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local deltaY = input.Position.Y - tabDragStartY
            tabTotalDragY = tabTotalDragY + math.abs(deltaY)
            local vp = getViewport()
            window.YOffset = math.clamp(tabStartOffset + deltaY, 10, math.max(10, vp.Y - panel.AbsoluteSize.Y - 10))
            applyDockLayout(false)
        end
    end)
    table.insert(Library.Connections, sideTabChangedConn)

    sideTab.MouseButton1Click:Connect(function()
        if tabTotalDragY < 6 then
            window.Minimized = not window.Minimized
            applyDockLayout(true)
        end
    end)

    return window
end

-- --------------------------------------------------
-- TAB SYSTEM
-- --------------------------------------------------
function Library:CreateTab(tabName)
    local tab = {
        Name = tabName,
        Window = self,
        Items = {}
    }

    -- Create Tab Selection Button
    local tabBtn = create("TextButton", {
        Name = tabName .. "TabBtn",
        Size = UDim2.new(0, 60, 1, 0),
        BackgroundColor3 = Library.Theme.Card,
        BorderSizePixel = 0,
        Text = tabName,
        Font = Enum.Font.GothamMedium,
        TextSize = 11,
        TextColor3 = Library.Theme.Muted,
        Parent = self.TabNav
    }, {
        create("UICorner", { CornerRadius = UDim.new(0, 6) })
    })
    tab.TabBtn = tabBtn

    -- Tab Scrolling Page with Automatic Canvas Sizing
    local page = create("ScrollingFrame", {
        Name = tabName .. "Page",
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Visible = false,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = Library.Theme.Accent,
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        Parent = self.Container
    })
    create("UIListLayout", {
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 6),
        Parent = page
    })
    create("UIPadding", {
        PaddingTop = UDim.new(0, 2),
        PaddingBottom = UDim.new(0, 4),
        PaddingLeft = UDim.new(0, 2),
        PaddingRight = UDim.new(0, 2),
        Parent = page
    })
    tab.Page = page

    -- Tab Switching Logic
    tabBtn.MouseButton1Click:Connect(function()
        for _, t in ipairs(self.Tabs) do
            t.Page.Visible = false
            t.TabBtn.BackgroundColor3 = Library.Theme.Card
            t.TabBtn.TextColor3 = Library.Theme.Muted
        end
        page.Visible = true
        tabBtn.BackgroundColor3 = Library.Theme.Accent
        tabBtn.TextColor3 = Library.Theme.White
        self.ActiveTab = tab
    end)

    table.insert(self.Tabs, tab)

    if #self.Tabs == 1 then
        page.Visible = true
        tabBtn.BackgroundColor3 = Library.Theme.Accent
        tabBtn.TextColor3 = Library.Theme.White
        self.ActiveTab = tab
    end

    -- --------------------------------------------------
    -- COMPONENT FACTORIES
    -- --------------------------------------------------

    -- 1. TOGGLE COMPONENT
    function tab:CreateToggle(options)
        options = options or {}
        local name = options.Name or "Toggle"
        local default = options.Default or false
        local callback = options.Callback or function() end
        local parentObj = options.Parent or page
        local state = default

        local row = create("TextButton", {
            Name = name .. "Row",
            Size = UDim2.new(1, 0, 0, 28),
            BackgroundColor3 = Library.Theme.Card,
            BorderSizePixel = 0,
            AutoButtonColor = false,
            Text = "",
            Parent = parentObj
        }, {
            create("UICorner", { CornerRadius = UDim.new(0, 6) }),
            create("TextLabel", {
                Size = UDim2.new(1, -40, 1, 0),
                Position = UDim2.new(0, 10, 0, 0),
                BackgroundTransparency = 1,
                Text = name,
                Font = Enum.Font.GothamMedium,
                TextSize = 11,
                TextColor3 = Library.Theme.White,
                TextXAlignment = Enum.TextXAlignment.Left
            })
        })

        local track = create("Frame", {
            Size = UDim2.new(0, 24, 0, 12),
            Position = UDim2.new(1, -30, 0.5, -6),
            BackgroundColor3 = state and Library.Theme.Accent or Library.Theme.OffTrack,
            BorderSizePixel = 0,
            Parent = row
        }, {
            create("UICorner", { CornerRadius = UDim.new(1, 0) })
        })

        local knob = create("Frame", {
            Size = UDim2.new(0, 10, 0, 10),
            Position = state and UDim2.new(1, -11, 0.5, -5) or UDim2.new(0, 1, 0.5, -5),
            BackgroundColor3 = Library.Theme.White,
            BorderSizePixel = 0,
            Parent = track
        }, {
            create("UICorner", { CornerRadius = UDim.new(1, 0) })
        })

        local function setToggle(val)
            state = val
            local targetColor = state and Library.Theme.Accent or Library.Theme.OffTrack
            local targetPos = state and UDim2.new(1, -11, 0.5, -5) or UDim2.new(0, 1, 0.5, -5)
            TweenService:Create(track, TweenInfo.new(0.15), { BackgroundColor3 = targetColor }):Play()
            TweenService:Create(knob, TweenInfo.new(0.15), { Position = targetPos }):Play()
            task.spawn(callback, state)
        end

        row.MouseButton1Click:Connect(function()
            setToggle(not state)
        end)

        return { SetState = setToggle, GetState = function() return state end }
    end

    -- 2. BUTTON COMPONENT
    function tab:CreateButton(options)
        options = options or {}
        local name = options.Name or "Button"
        local callback = options.Callback or function() end
        local parentObj = options.Parent or page

        local btn = create("TextButton", {
            Name = name .. "Btn",
            Size = UDim2.new(1, 0, 0, 26),
            BackgroundColor3 = options.Color or Library.Theme.Accent,
            Text = name,
            Font = Enum.Font.GothamBold,
            TextSize = 11,
            TextColor3 = Library.Theme.White,
            BorderSizePixel = 0,
            Parent = parentObj
        }, {
            create("UICorner", { CornerRadius = UDim.new(0, 6) }),
            create("UIStroke", { Color = Color3.new(1,1,1), Transparency = 0.85, Thickness = 1 })
        })

        btn.MouseButton1Click:Connect(function()
            TweenService:Create(btn, TweenInfo.new(0.1), { BackgroundTransparency = 0.3 }):Play()
            task.wait(0.1)
            TweenService:Create(btn, TweenInfo.new(0.1), { BackgroundTransparency = 0 }):Play()
            task.spawn(callback)
        end)

        return btn
    end

    -- 3. SLIDER COMPONENT
    function tab:CreateSlider(options)
        options = options or {}
        local name = options.Name or "Slider"
        local min = options.Min or 0
        local max = options.Max or 100
        local default = options.Default or min
        local precision = options.Precision or 0
        local suffix = options.Suffix or ""
        local callback = options.Callback or function() end
        local parentObj = options.Parent or page

        local value = math.clamp(default, min, max)

        local sliderFrame = create("Frame", {
            Name = name .. "Slider",
            Size = UDim2.new(1, 0, 0, 36),
            BackgroundColor3 = Library.Theme.Card,
            BorderSizePixel = 0,
            Parent = parentObj
        }, {
            create("UICorner", { CornerRadius = UDim.new(0, 6) }),
            create("TextLabel", {
                Size = UDim2.new(1, -60, 0, 18),
                Position = UDim2.new(0, 10, 0, 2),
                BackgroundTransparency = 1,
                Text = name,
                Font = Enum.Font.GothamMedium,
                TextSize = 11,
                TextColor3 = Library.Theme.White,
                TextXAlignment = Enum.TextXAlignment.Left
            })
        })

        local function formatVal(v)
            if precision > 0 then
                return string.format("%." .. precision .. "f", v) .. suffix
            else
                return tostring(math.floor(v)) .. suffix
            end
        end

        local valLabel = create("TextLabel", {
            Size = UDim2.new(0, 50, 0, 18),
            Position = UDim2.new(1, -55, 0, 2),
            BackgroundTransparency = 1,
            Text = formatVal(value),
            Font = Enum.Font.GothamBold,
            TextSize = 11,
            TextColor3 = Library.Theme.Muted,
            TextXAlignment = Enum.TextXAlignment.Right,
            Parent = sliderFrame
        })

        local track = create("Frame", {
            Size = UDim2.new(1, -20, 0, 4),
            Position = UDim2.new(0, 10, 0, 24),
            BackgroundColor3 = Library.Theme.OffTrack,
            BorderSizePixel = 0,
            Parent = sliderFrame
        }, {
            create("UICorner", { CornerRadius = UDim.new(1, 0) })
        })

        local fill = create("Frame", {
            Size = UDim2.new((value - min) / math.max(1, max - min), 0, 1, 0),
            BackgroundColor3 = Library.Theme.Accent,
            BorderSizePixel = 0,
            Parent = track
        }, {
            create("UICorner", { CornerRadius = UDim.new(1, 0) })
        })

        local dragging = false
        local function updateSlider(input)
            local percent = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
            local rawVal = min + (max - min) * percent
            if precision == 0 then
                value = math.floor(rawVal + 0.5)
            else
                local mult = 10 ^ precision
                value = math.floor(rawVal * mult + 0.5) / mult
            end
            valLabel.Text = formatVal(value)
            fill.Size = UDim2.new(percent, 0, 1, 0)
            task.spawn(callback, value)
        end

        local dragConn, endConn
        sliderFrame.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                updateSlider(input)

                if not dragConn then
                    dragConn = UserInputService.InputChanged:Connect(function(inp)
                        if dragging and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
                            updateSlider(inp)
                        end
                    end)
                end
                if not endConn then
                    endConn = UserInputService.InputEnded:Connect(function(inp)
                        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                            dragging = false
                            if dragConn then dragConn:Disconnect(); dragConn = nil end
                            if endConn then endConn:Disconnect(); endConn = nil end
                        end
                    end)
                end
            end
        end)

        return {
            SetValue = function(val)
                val = math.clamp(val, min, max)
                local percent = (val - min) / math.max(1, max - min)
                value = val
                valLabel.Text = formatVal(value)
                fill.Size = UDim2.new(percent, 0, 1, 0)
                task.spawn(callback, value)
            end,
            GetValue = function() return value end
        }
    end

