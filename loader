local function getNotifContainer()
    if Library.NotifContainer and Library.NotifContainer.Parent then
        return Library.NotifContainer
    end
    local notifSg = create("ScreenGui", {
        Name = "MyungLibrary_Notifs",
        ResetOnSpawn = false,
        DisplayOrder = 99999,
        IgnoreGuiInset = true,
        Parent = getGuiParent()
    })
    table.insert(Library.Instances, notifSg)

    local container = create("Frame", {
        Name = "NotifContainer",
        Size = UDim2.new(0, 240, 1, -20),
        Position = UDim2.new(1, -250, 0, 10),
        BackgroundTransparency = 1,
        Parent = notifSg
    }, {
        create("UIListLayout", {
            SortOrder = Enum.SortOrder.LayoutOrder,
            VerticalAlignment = Enum.VerticalAlignment.Bottom,
            Padding = UDim.new(0, 8)
        })
    })
    Library.NotifContainer = container
    return container
end

function Library:Notify(config)
    config = config or {}
    local title = config.Title or "Notification"
    local content = config.Content or ""
    local duration = config.Duration or 3.5
    local nType = config.Type or "Info"

    local accentColor = Library.Theme.Accent
    if nType == "Success" or nType == "Green" then
        accentColor = Library.Theme.Green
    elseif nType == "Warning" or nType == "Yellow" then
        accentColor = Library.Theme.Yellow
    elseif nType == "Error" or nType == "Red" then
        accentColor = Color3.fromRGB(235, 77, 75)
    end

    local container = getNotifContainer()

    local card = create("Frame", {
        Name = "NotifCard",
        Size = UDim2.new(1, 0, 0, 0),
        BackgroundColor3 = Library.Theme.Surface,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        Parent = container
    }, {
        create("UICorner", { CornerRadius = UDim.new(0, 8) }),
        create("UIStroke", { Color = Library.Theme.Border, Thickness = 1.2 }),
        create("Frame", {
            Name = "Indicator",
            Size = UDim2.new(0, 4, 1, 0),
            BackgroundColor3 = accentColor,
            BorderSizePixel = 0
        }),
        create("TextLabel", {
            Name = "TitleLabel",
            Size = UDim2.new(1, -20, 0, 18),
            Position = UDim2.new(0, 12, 0, 6),
            BackgroundTransparency = 1,
            Text = title,
            Font = Enum.Font.GothamBold,
            TextSize = 12,
            TextColor3 = Library.Theme.White,
            TextXAlignment = Enum.TextXAlignment.Left
        }),
        create("TextLabel", {
            Name = "ContentLabel",
            Size = UDim2.new(1, -20, 0, 24),
            Position = UDim2.new(0, 12, 0, 24),
            BackgroundTransparency = 1,
            Text = content,
            Font = Enum.Font.Gotham,
            TextSize = 11,
            TextColor3 = Library.Theme.Muted,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextWrapped = true
        })
    })

    local ti = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    TweenService:Create(card, ti, { Size = UDim2.new(1, 0, 0, 54) }):Play()

    task.delay(duration, function()
        if card and card.Parent then
            local tweenOut = TweenService:Create(card, ti, { Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1 })
            tweenOut:Play()
            tweenOut.Completed:Connect(function()
                card:Destroy()
            end)
        end
    end)
end

function Library:SetToggleKey(keyCode)
    Library.ToggleKey = keyCode
end

function Library:SetTheme(themeArg)
    if type(themeArg) == "string" and Library.Themes[themeArg] then
        Library.Theme = Library.Themes[themeArg]
    elseif type(themeArg) == "table" then
        for k, v in pairs(themeArg) do
            Library.Theme[k] = v
        end
    end
end

