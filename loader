        local function createRGBSlider(cName, defaultVal, onChange)
            local sFrame = create("Frame", {
                Size = UDim2.new(1, 0, 0, 24),
                BackgroundTransparency = 1,
                Parent = sliderHolder
            }, {
                create("TextLabel", {
                    Size = UDim2.new(0, 15, 1, 0),
                    BackgroundTransparency = 1,
                    Text = cName,
                    Font = Enum.Font.GothamBold,
                    TextSize = 10,
                    TextColor3 = Library.Theme.Muted
                })
            })

            local track = create("Frame", {
                Size = UDim2.new(1, -25, 0, 4),
                Position = UDim2.new(0, 20, 0.5, -2),
                BackgroundColor3 = Library.Theme.OffTrack,
                BorderSizePixel = 0,
                Parent = sFrame
            }, {
                create("UICorner", { CornerRadius = UDim.new(1, 0) })
            })

            local fill = create("Frame", {
                Size = UDim2.new(defaultVal / 255, 0, 1, 0),
                BackgroundColor3 = cName == "R" and Color3.fromRGB(235, 77, 75) or (cName == "G" and Color3.fromRGB(72, 199, 116) or Color3.fromRGB(9, 132, 227)),
                BorderSizePixel = 0,
                Parent = track
            }, {
                create("UICorner", { CornerRadius = UDim.new(1, 0) })
            })

            local dragging = false
            local function update(input)
                local percent = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
                fill.Size = UDim2.new(percent, 0, 1, 0)
                onChange(math.floor(percent * 255))
            end

            local sDragConn, sEndConn
            sFrame.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    update(input)

                    if not sDragConn then
                        sDragConn = UserInputService.InputChanged:Connect(function(inp)
                            if dragging and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
                                update(inp)
                            end
                        end)
                    end
                    if not sEndConn then
                        sEndConn = UserInputService.InputEnded:Connect(function(inp)
                            if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                                dragging = false
                                if sDragConn then sDragConn:Disconnect(); sDragConn = nil end
                                if sEndConn then sEndConn:Disconnect(); sEndConn = nil end
                            end
                        end)
                    end
                end
            end)
        end

        local r, g, b = math.floor(color.R * 255), math.floor(color.G * 255), math.floor(color.B * 255)

        local function updateColor()
            color = Color3.fromRGB(r, g, b)
            preview.BackgroundColor3 = color
            task.spawn(callback, color)
        end

        createRGBSlider("R", r, function(v) r = v; updateColor() end)
        createRGBSlider("G", g, function(v) g = v; updateColor() end)
        createRGBSlider("B", b, function(v) b = v; updateColor() end)

        rowBtn.MouseButton1Click:Connect(function()
