    function tab:CreateSection(sectionName)
        local sectionFrame = create("Frame", {
            Name = sectionName .. "Section",
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundColor3 = Library.Theme.Card,
            BorderSizePixel = 0,
            Parent = page
        }, {
            create("UICorner", { CornerRadius = UDim.new(0, 8) }),
            create("UIStroke", { Color = Library.Theme.Border, Thickness = 1, Transparency = 0.5 }),
            create("UIPadding", {
                PaddingTop = UDim.new(0, 8),
                PaddingBottom = UDim.new(0, 8),
                PaddingLeft = UDim.new(0, 8),
                PaddingRight = UDim.new(0, 8)
            }),
            create("UIListLayout", {
                SortOrder = Enum.SortOrder.LayoutOrder,
                Padding = UDim.new(0, 6)
            }),
            create("TextLabel", {
                Name = "SectionHeader",
                Size = UDim2.new(1, 0, 0, 16),
                BackgroundTransparency = 1,
                Text = string.upper(sectionName),
                Font = Enum.Font.GothamBold,
                TextSize = 10,
                TextColor3 = Library.Theme.Accent,
                TextXAlignment = Enum.TextXAlignment.Left,
                LayoutOrder = -999
            })
        })

        local section = {
            Page = sectionFrame,
            Window = self.Window
        }

        local selfTab = self
        local function bindFactory(fn)
            return function(secSelf, opts)
                if type(opts) == "string" then
                    opts = { Text = opts }
                elseif type(opts) ~= "table" then
                    opts = {}
                end
                opts.Parent = sectionFrame
                return fn(selfTab, opts)
            end
        end

        section.CreateToggle = bindFactory(selfTab.CreateToggle)
        section.CreateButton = bindFactory(selfTab.CreateButton)
        section.CreateSlider = bindFactory(selfTab.CreateSlider)
        section.CreateDropdown = bindFactory(selfTab.CreateDropdown)
        section.CreateKeybind = bindFactory(selfTab.CreateKeybind)
        section.CreateTextbox = bindFactory(selfTab.CreateTextbox)
        section.CreateLabel = bindFactory(selfTab.CreateLabel)
        section.CreateParagraph = bindFactory(selfTab.CreateParagraph)
        section.CreateColorpicker = bindFactory(selfTab.CreateColorpicker)

        return section
    end

    return tab
end

-- --------------------------------------------------
-- CLEANUP / UNLOAD SYSTEM
-- --------------------------------------------------
function Library:Destroy()
    for _, inst in ipairs(Library.Instances) do
        pcall(function() inst:Destroy() end)
    end
    for _, conn in ipairs(Library.Connections) do
        pcall(function() conn:Disconnect() end)
    end
    Library.Instances = {}
    Library.Connections = {}
    Library.ToggleConnection = nil
    Library.NotifContainer = nil
end

return Library
